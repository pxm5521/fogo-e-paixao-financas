# Copie este arquivo para ".env" e preencha com as chaves do SEU projeto Firebase.
# Veja o passo a passo em SETUP.md.
# Essas chaves NÃO são secretas (o Firebase foi feito para expor essa config no
# navegador) — quem protege seus dados são as regras do Firestore (firestore.rules)
# e o login (Firebase Auth), não essas variáveis.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# E-mail(s) autorizados a usar o site, separados por vírgula.
# Confira também firestore.rules — a regra de segurança real fica lá,
# isso aqui só controla o que a interface mostra.
VITE_ALLOWED_EMAILS=
